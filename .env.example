# Copy to .env for local development. Every variable is optional.

# Optional shared passcode. Unset = no gate, anyone with the URL can play.
PASSCODE=
# Signs the passcode cookie and the opaque round ids. Any long random string:
#   openssl rand -base64 32
SESSION_SECRET=
# Absolute site URL: used for links in emails (and by adapter-node in production).
ORIGIN=http://localhost:5173

# Where the pipeline's published output lives (rounds.json + faces/ + credits/).
# Unset or missing manifest: the bundled demo rounds in ./demo are used.
DATA_DIR=./data/public
# Writable directory for the SQLite database (accounts, sessions, saved scores).
STATE_DIR=./data/state

# The daily rolls over at midnight in this time zone; the email goes out at EMAIL_HOUR.
DAILY_TZ=America/New_York
EMAIL_HOUR=7
# EMAIL_DAILY=off   # disable the morning email job entirely

# SMTP relay for account and daily emails (unauthenticated, e.g. a local postfix).
# Unset: emails are printed to the console instead, so links work in development.
SMTP_HOST=
SMTP_PORT=25
EMAIL_FROM=Ethnoguessr 2.0 <ethnoguessr@example.com>
